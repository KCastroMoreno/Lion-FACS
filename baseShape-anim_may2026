def UL_check(nameUL):
    """Return list of shapes, converting UL -> Lower+Upper"""
    if nameUL.endswith('UL'):
        base = nameUL[:-2]
        return [base + 'Lower', base + 'Upper']
    return [nameUL]

def L_R_Check(nameLR_list):
    """Return shapes with Face:face_main_ctrl. prefix.
       If shape exists as-is -> return it (single/center shape).
       Else -> return l/r prefix variations (bilateral pair, fired together).
    """
    result_shapes = []
    for shape in nameLR_list:
        full_shape = C_name + Ctrl_name + shape
        if cmds.objExists(full_shape):
            result_shapes.append(full_shape)
        else:
            result_shapes.append(C_name + Ctrl_name + 'l' + shape)
            result_shapes.append(C_name + Ctrl_name + 'r' + shape)
    return result_shapes

def get_short_attr(full_attr):
    """Strip 'Face:face_main_ctrl.' prefix to get bare attribute name."""
    prefix = C_name + Ctrl_name
    if full_attr.startswith(prefix):
        return full_attr[len(prefix):]
    return full_attr


def build_resolved_shape_pairs():
    """
    Walk Ani_shapeNames, resolve each to existing character attrs.
    l/r siblings resolve into the same pair so they key simultaneously.
    Returns list of dicts: {char_attrs, hud_names, key_value}
    """
    pairs = []
    for name in Ani_shapeNames:
        if name.endswith('X'):
            base = name[:-1]
            key_value = -100
        else:
            base = name
            key_value = 100

        UL_shapes   = UL_check(base)
        full_shapes = L_R_Check(UL_shapes)
        existing    = [s for s in full_shapes if cmds.objExists(s)]

        if not existing:
            print('[Skip] No existing attributes found for: ' + name)
            continue

        hud_names = [get_short_attr(s) for s in existing]

        pairs.append({
            'char_attrs': existing,
            'hud_names':  hud_names,
            'key_value':  key_value
        })

    return pairs


def animate_shape_keys(pairs):
    """Animate each resolved shape group sequentially: 0->value->0."""
    current_time = int(cmds.textField('b8', q=1, tx=1))
    for pair in pairs:
        key_shape_group(pair['char_attrs'], pair['key_value'], current_time)
        current_time += 10


def key_shape_group(shape_list, key_value, start_frame):
    """Key all shapes in the group at the same time.
       If a shape has an inverted range (max=0), auto-flips to negative value."""
    for shape in shape_list:
        try:
            cmds.setAttr(shape, 0)
            cmds.setKeyframe(shape, t=start_frame, v=0)
        except Exception as e:
            print("[Warning] key@0 failed for " + shape + ": " + str(e))
    for shape in shape_list:
        try:
            cmds.setAttr(shape, key_value)
            cmds.setKeyframe(shape, t=start_frame + 5, v=key_value)
        except:
            try:
                alt_value = -abs(key_value)
                cmds.setAttr(shape, alt_value)
                cmds.setKeyframe(shape, t=start_frame + 5, v=alt_value)
                print("[Info] " + shape + " keyed at " + str(alt_value) + " (inverted range)")
            except Exception as e2:
                print("[Warning] key@value failed for " + shape + ": " + str(e2))
    for shape in shape_list:
        try:
            cmds.setAttr(shape, 0)
            cmds.setKeyframe(shape, t=start_frame + 10, v=0)
        except Exception as e:
            print("[Warning] key@0 return failed for " + shape + ": " + str(e))


def reset_all_shapes(shape_list):
    """Delete all keys and reset all shapes to 0."""
    all_shapes = []
    for name in shape_list:
        UL_shapes    = UL_check(name.replace('X', ''))
        Final_shapes = L_R_Check(UL_shapes)
        all_shapes.extend(Final_shapes)

    all_shapes = list(set(all_shapes))
    for shape in all_shapes:
        if cmds.objExists(shape):
            try:
                cmds.cutKey(shape)
                cmds.setAttr(shape, 0)
            except:
                pass


