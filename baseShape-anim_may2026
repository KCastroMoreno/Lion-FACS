def hud_attr_path(attr_name):
    return 'HUDkcm_blendShape.' + attr_name


def cleanup_scene():
    if cmds.objExists('HUDkcm_cube'):
        cmds.delete('HUDkcm_cube')
    if cmds.objExists('HUDkcm_blendShape'):
        cmds.delete('HUDkcm_blendShape')
    if cmds.headsUpDisplay('HUDShapeNames', exists=True):
        cmds.headsUpDisplay('HUDShapeNames', remove=True)
    try:
        cmds.headsUpDisplay(block=7, rem=True)
    except:
        pass
    print("Cleaned up cube and HUD.")


def create_hud_cube_and_blendshape(hud_target_names):
    """Create HUD cube with blendShape targets matching resolved char attr names."""
    base_cube = cmds.polyCube(name='HUDkcm_cube', width=1, height=1, depth=1)[0]

    targets = []
    for name in hud_target_names:
        tgt = cmds.duplicate(base_cube, name=name)[0]
        targets.append(tgt)

    blend_node = cmds.blendShape(targets, base_cube, name='HUDkcm_blendShape')[0]
    cmds.delete(targets)
    print("Created HUD blendShape with " + str(len(hud_target_names)) + " targets.")


def key_hud_shapes(pairs, start_time):
    """Key HUD cube attrs in sync with character attrs."""
    current_time = start_time
    for pair in pairs:
        for hud_name in pair['hud_names']:
            attr = hud_attr_path(hud_name)
            if not cmds.objExists(attr):
                print('[Skip] Missing HUD attribute: ' + attr)
                continue
            cmds.setKeyframe(attr, value=0,   t=current_time)
            cmds.setKeyframe(attr, value=100, t=current_time + 5)
            cmds.setKeyframe(attr, value=0,   t=current_time + 10)
        current_time += 10
    return current_time


def get_active_shapes_from_whitelist():
    """Read active HUD cube attrs for the viewport HUD display."""
    node = 'HUDkcm_blendShape'
    if not cmds.objExists(node):
        return ''

    attrs = cmds.listAttr(node, keyable=True) or []
    active_shapes = []
    for attr in attrs:
        full_attr = node + '.' + attr
        if cmds.objExists(full_attr):
            try:
                if cmds.getAttr(full_attr) > 0.0:
                    active_shapes.append(attr)
            except:
                continue

    return ', '.join(sorted(set(active_shapes)))


def show_filtered_hud_display():
    if cmds.headsUpDisplay('HUDShapeNames', exists=True):
        cmds.headsUpDisplay('HUDShapeNames', remove=True)
    try:
        cmds.headsUpDisplay(block=7, rem=True)
    except:
        pass

    cmds.headsUpDisplay(
        'HUDShapeNames',
        section=7,
        block=7,
        blockSize='medium',
        dataFontSize='large',
        dataAlignment='left',
        command=get_active_shapes_from_whitelist,
        attachToRefresh=True
    )


def run_hud_animation(pairs):
    cleanup_scene()

    seen = set()
    hud_target_names = []
    for pair in pairs:
        for n in pair['hud_names']:
            if n not in seen:
                seen.add(n)
                hud_target_names.append(n)

    create_hud_cube_and_blendshape(hud_target_names)

    start_frame     = int(cmds.textField('b8', q=1, tx=1))
    end_of_hud_keys = key_hud_shapes(pairs, start_frame)

    cmds.playbackOptions(minTime=start_frame, maxTime=end_of_hud_keys)
    print("Timeline adjusted to " + str(start_frame) + " -> " + str(end_of_hud_keys))

    show_filtered_hud_display()


# === Run ===

def KeyShapes():
    pairs = build_resolved_shape_pairs()
    animate_shape_keys(pairs)
    run_hud_animation(pairs)

def DeleteKeyShapes():
    cleanup_scene()
    reset_all_shapes(Ani_shapeNames)


